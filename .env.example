# Credenziali Discord OAuth2 e Lista Amministratori Autorizzati (separati da virgola)
# ⚠️ Inserisci qui i tuoi valori reali. Non committare mai i secret.
DISCORD_CLIENT_ID=your_discord_client_id
DISCORD_CLIENT_SECRET=your_discord_client_secret
# Più admin separati da virgola, es. 123456789,987654321
DISCORD_ADMIN_IDS=your_discord_user_id

# Segreto per firmare i cookie di sessione (genera con: openssl rand -base64 32)
SESSION_SECRET=change_me

# Credenziali HTTP Basic Auth per la sezione admin (barriera d'accesso aggiuntiva)
ADMIN_BASIC_USER=admin
ADMIN_BASIC_PASSWORD=change_me
